CREATE TRIGGER trg_validar_salario_minimo
BEFORE INSERT ON empleados
FOR EACH ROW
BEGIN
    IF NEW.salario < 1134.00 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Error: el salario no puede ser inferior al SMI (1134.00).';
    END IF;
END //

DELIMITER ;

CREATE TABLE IF NOT EXISTS historial_salarios (
    id_log INT AUTO_INCREMENT PRIMARY KEY,
    id_empleado INT NOT NULL,
    salario_anterior DECIMAL(10, 2) NOT NULL,
    salario_nuevo DECIMAL(10, 2) NOT NULL,
    fecha_cambio TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

DELIMITER //

CREATE TRIGGER trg_auditoria_salario
AFTER UPDATE ON empleados
FOR EACH ROW
BEGIN
    IF OLD.salario <> NEW.salario THEN
        INSERT INTO historial_salarios (id_empleado, salario_anterior, salario_nuevo)
        VALUES (OLD.id_empleado, OLD.salario, NEW.salario);
    END IF;
END //

DELIMITER ;

DROP DATABASE IF EXISTS transporte_mercancias;
CREATE DATABASE transporte_mercancias
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_0900_ai_ci;

USE transporte_mercancias;

-- =========================================================
-- 1. VEHÍCULOS (Especialización total y disjunta)
-- =========================================================
CREATE TABLE vehiculo (
    matricula VARCHAR(10) PRIMARY KEY,
    marca VARCHAR(50) NOT NULL,
    modelo VARCHAR(50) NOT NULL,
    anio YEAR NOT NULL CHECK (anio >= 1980),
    tipo_vehiculo ENUM('CAMION', 'FURGONETA') NOT NULL,
    UNIQUE KEY uq_vehiculo_tipo (matricula, tipo_vehiculo)
);

CREATE TABLE camion (
    matricula VARCHAR(10) PRIMARY KEY,
    tipo_vehiculo ENUM('CAMION', 'FURGONETA') NOT NULL DEFAULT 'CAMION'
        CHECK (tipo_vehiculo = 'CAMION'),
    tonelaje_maximo DECIMAL(6, 2) NOT NULL CHECK (tonelaje_maximo > 0),
    CONSTRAINT fk_camion_vehiculo
        FOREIGN KEY (matricula, tipo_vehiculo)
        REFERENCES vehiculo (matricula, tipo_vehiculo)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

CREATE TABLE furgoneta (
    matricula VARCHAR(10) PRIMARY KEY,
    tipo_vehiculo ENUM('CAMION', 'FURGONETA') NOT NULL DEFAULT 'FURGONETA'
        CHECK (tipo_vehiculo = 'FURGONETA'),
    capacidad_m3 DECIMAL(6, 2) NOT NULL CHECK (capacidad_m3 > 0),
    CONSTRAINT fk_furgoneta_vehiculo
        FOREIGN KEY (matricula, tipo_vehiculo)
        REFERENCES vehiculo (matricula, tipo_vehiculo)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

-- =========================================================
-- 2. EMPLEADOS (Especialización total y disjunta)
-- =========================================================
CREATE TABLE empleado (
    dni CHAR(9) PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    telefono VARCHAR(15) NOT NULL,
    tipo_empleado ENUM('CONDUCTOR', 'ADMINISTRATIVO') NOT NULL,
    UNIQUE KEY uq_empleado_tipo (dni, tipo_empleado)
);

CREATE TABLE conductor (
    dni CHAR(9) PRIMARY KEY,
    tipo_empleado ENUM('CONDUCTOR', 'ADMINISTRATIVO') NOT NULL DEFAULT 'CONDUCTOR'
        CHECK (tipo_empleado = 'CONDUCTOR'),
    num_carnet VARCHAR(20) NOT NULL UNIQUE,
    categoria ENUM('B', 'C1', 'C', 'C1+E', 'C+E') NOT NULL,
    CONSTRAINT fk_conductor_empleado
        FOREIGN KEY (dni, tipo_empleado)
        REFERENCES empleado (dni, tipo_empleado)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

CREATE TABLE administrativo (
    dni CHAR(9) PRIMARY KEY,
    tipo_empleado ENUM('CONDUCTOR', 'ADMINISTRATIVO') NOT NULL DEFAULT 'ADMINISTRATIVO'
        CHECK (tipo_empleado = 'ADMINISTRATIVO'),
    departamento VARCHAR(60) NOT NULL,
    CONSTRAINT fk_administrativo_empleado
        FOREIGN KEY (dni, tipo_empleado)
        REFERENCES empleado (dni, tipo_empleado)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

-- =========================================================
-- 3. VIAJES (Relaciones 1:N con conductor y vehículo)
-- =========================================================
CREATE TABLE viaje (
    num_viaje INT AUTO_INCREMENT PRIMARY KEY,
    fecha_salida DATETIME NOT NULL,
    origen VARCHAR(100) NOT NULL,
    destino VARCHAR(100) NOT NULL,
    dni_conductor CHAR(9) NOT NULL,
    matricula_vehiculo VARCHAR(10) NOT NULL,
    CHECK (origen <> destino),
    CONSTRAINT fk_viaje_conductor
        FOREIGN KEY (dni_conductor) REFERENCES conductor (dni)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    CONSTRAINT fk_viaje_vehiculo
        FOREIGN KEY (matricula_vehiculo) REFERENCES vehiculo (matricula)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

-- =========================================================
-- 4. TRAMOS (Entidad débil dependiente de viaje)
-- =========================================================
CREATE TABLE tramo (
    num_viaje INT NOT NULL,
    num_orden INT NOT NULL CHECK (num_orden >= 1),
    distancia_km DECIMAL(7, 2) NOT NULL CHECK (distancia_km > 0),
    fecha_inicio DATETIME NOT NULL,
    fecha_fin DATETIME NOT NULL,
    PRIMARY KEY (num_viaje, num_orden),
    CHECK (fecha_fin >= fecha_inicio),
    CONSTRAINT fk_tramo_viaje
        FOREIGN KEY (num_viaje) REFERENCES viaje (num_viaje)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

-- =========================================================
-- 5. GESTIÓN DE VIAJES (Relación N:M administrativo - viaje)
-- =========================================================
CREATE TABLE gestion_viaje (
    dni_administrativo CHAR(9) NOT NULL,
    num_viaje INT NOT NULL,
    fecha_gestion TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (dni_administrativo, num_viaje),
    CONSTRAINT fk_gestion_administrativo
        FOREIGN KEY (dni_administrativo) REFERENCES administrativo (dni)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    CONSTRAINT fk_gestion_viaje
        FOREIGN KEY (num_viaje) REFERENCES viaje (num_viaje)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

DELIMITER //

CREATE TRIGGER trg_validar_carnet_camion
BEFORE INSERT ON viaje
FOR EACH ROW
BEGIN
    DECLARE v_tipo_vehiculo ENUM('CAMION', 'FURGONETA');
    DECLARE v_categoria ENUM('B', 'C1', 'C', 'C1+E', 'C+E');

    SELECT tipo_vehiculo INTO v_tipo_vehiculo
    FROM vehiculo
    WHERE matricula = NEW.matricula_vehiculo;

    SELECT categoria INTO v_categoria
    FROM conductor
    WHERE dni = NEW.dni_conductor;

    IF v_tipo_vehiculo = 'CAMION' AND v_categoria = 'B' THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Error: un conductor con carnet B no puede realizar un viaje en camión.';
    END IF;
END //

DELIMITER ;

